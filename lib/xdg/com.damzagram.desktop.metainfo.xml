    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0</project_license>
    <name>DamZaGram Desktop</name>
    <summary>Telegram client with JavaScript plugins, based on AyuGram</summary>
    <description>
        <p>DamZaGram is a Telegram Desktop client by @wetakush, based on AyuGram by Radolyn Labs.</p>
        <p>Everything AyuGram has (Ghost Mode, Anti-Recall, filters, deep customization) plus a full JavaScript plugin system with hot reload, built-in plugins and a DevTools console.</p>
    </description>
    <categories>
        <category>Network</category>
        <category>InstantMessaging</category>
    </categories>
    <update_contact>t.me/wetakush</update_contact>
    <developer_name>@wetakush</developer_name>
    <url type="homepage">https://t.me/wetakush</url>
    <url type="contact">https://t.me/wetakush</url>
    <url type="translate">https://crowdin.com/project/ayugram</url>
    <url type="vcs-browser">https://github.com/AyuGram/AyuGramDesktop</url>
    <screenshots>
      <screenshot type="default">
        <image>https://raw.githubusercontent.com/telegramdesktop/tdesktop/dev/docs/assets/preview.png</image>
      </screenshot>
    </screenshots>
