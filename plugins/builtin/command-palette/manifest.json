{
  "id": "command-palette",
  "name": "Командная палитра",
  "version": "1.0.0",
  "author": "@wetakush",
  "builtin": true,
  "description": "Ctrl+Shift+K — мгновенный поиск по чатам, командам плагинов и действиям клиента. Нечёткий поиск, исправление раскладки, префиксы > и @.",
  "settings": [
    {
      "key": "shortcut",
      "type": "string",
      "title": "Горячая клавиша",
      "default": "Ctrl+Shift+K",
      "description": "Синтаксис Qt: Ctrl+Shift+K, Ctrl+Shift+Space, Alt+P. Ctrl+Shift+P занят менеджером плагинов."
    },
    {
      "key": "maxResults",
      "type": "number",
      "title": "Сколько результатов показывать",
      "default": 10,
      "min": 3,
      "max": 30
    },
    {
      "key": "showChats",
      "type": "bool",
      "title": "Искать по чатам",
      "default": true
    },
    {
      "key": "showCommands",
      "type": "bool",
      "title": "Искать по командам плагинов",
      "default": true
    },
    {
      "key": "showActions",
      "type": "bool",
      "title": "Искать по действиям клиента",
      "default": true
    },
    {
      "key": "includeArchived",
      "type": "bool",
      "title": "Показывать чаты из архива",
      "default": true
    }
  ]
}
