{
  "id": "deleted-alerts",
  "name": "Удалённые сообщения",
  "version": "1.0.1",
  "author": "@wetakush",
  "builtin": true,
  "description": "Уведомляет, когда собеседник удаляет сообщение: кто, где и что именно. Ведёт журнал удалённого (/deleted), умеет перейти к сохранённому AyuGram сообщению.",
  "settings": [
    {
      "key": "onlyPrivate",
      "type": "bool",
      "title": "Только личные чаты",
      "default": true
    },
    {
      "key": "includeChannels",
      "type": "bool",
      "title": "Следить и за каналами",
      "default": false
    },
    {
      "key": "ignoreOwn",
      "type": "bool",
      "title": "Не сообщать о своих сообщениях",
      "default": true
    },
    {
      "key": "ignoreBots",
      "type": "bool",
      "title": "Не сообщать об удалениях у ботов",
      "default": true
    },
    {
      "key": "systemNotify",
      "type": "bool",
      "title": "Системное уведомление (иначе — всплывающая подсказка)",
      "default": true
    },
    {
      "key": "silent",
      "type": "bool",
      "title": "Уведомлять без звука",
      "default": true
    },
    {
      "key": "logSize",
      "type": "number",
      "title": "Сколько записей хранить в журнале",
      "default": 300,
      "min": 10,
      "max": 5000
    }
  ]
}
